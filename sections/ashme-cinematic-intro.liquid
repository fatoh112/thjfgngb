<section
  class="ashme-cinematic"
  data-ashme-cinematic
  data-cigarette-url="{{ 'ashme-intro-v3.glb' | asset_url }}"
  data-tray-url="{{ 'ashme-tray-v3.glb' | asset_url }}"
  data-product-eyebrow="THE ASHME ESSENTIAL"
  data-product-line="A better place for ash."
  aria-label="{{ section.settings.eyebrow | escape }}"
>
  <canvas class="ashme-cinematic__canvas" data-ashme-canvas aria-hidden="true"></canvas>
  <div class="ashme-cinematic__shade" aria-hidden="true"></div>
  <div class="ashme-cinematic__copy" data-ashme-copy>
    <span class="ashme-cinematic__eyebrow" data-ashme-eyebrow>{{ section.settings.eyebrow | escape }}</span>
    <p class="ashme-cinematic__line" data-ashme-line>{{ section.settings.supporting_text | escape }}</p>
  </div>
  <button class="ashme-cinematic__skip" type="button" data-ashme-skip aria-keyshortcuts="Escape">
    {{ section.settings.skip_label | escape }}
    <span aria-hidden="true">↗</span>
  </button>
  <button class="ashme-cinematic__record" type="button" data-ashme-record hidden>Start screen recording</button>
  <div class="ashme-cinematic__loading" data-ashme-loading role="progressbar" aria-label="Loading the AshMe intro" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <span class="ashme-cinematic__loading-brand">ASHME</span>
    <span class="ashme-cinematic__loading-track" aria-hidden="true"><i data-ashme-load-fill></i></span>
  </div>
  <span class="ashme-cinematic__progress" data-ashme-progress aria-hidden="true"></span>
</section>
<script src="{{ 'ashme-intro-v3.bundle.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "AshMe cinematic intro",
  "tag": "section",
  "class": "section-ashme-cinematic-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ASHME — A QUIETER KIND OF EVERYDAY" },
    { "type": "text", "id": "supporting_text", "label": "Supporting text", "default": "A small moment. A better way to handle ash." },
    { "type": "text", "id": "skip_label", "label": "Skip button", "default": "Skip intro" }
  ],
  "presets": [{ "name": "AshMe cinematic intro" }]
}
{% endschema %}
