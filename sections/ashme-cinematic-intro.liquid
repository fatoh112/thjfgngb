<section class="ashme-cinematic" data-ashme-cinematic data-cigarette-url="{{ 'ashme-cigarette.glb' | asset_url }}" data-tray-url="{{ 'ashme-tray.glb' | asset_url }}" data-product-eyebrow="THE ASHME ESSENTIAL" data-product-line="A better place for ash." aria-label="{{ section.settings.eyebrow | escape }}">
  <canvas class="ashme-cinematic__canvas" data-ashme-canvas aria-hidden="true"></canvas>
  <div class="ashme-cinematic__shade" aria-hidden="true"></div>
  <div class="ashme-cinematic__copy" data-ashme-copy>
    <span class="ashme-cinematic__eyebrow" data-ashme-eyebrow>{{ section.settings.eyebrow | escape }}</span>
    <p class="ashme-cinematic__line" data-ashme-line>{{ section.settings.supporting_text | escape }}</p>
  </div>
  <button class="ashme-cinematic__skip" type="button" data-ashme-skip aria-keyshortcuts="Escape">
    {{ section.settings.skip_label | escape }}
    <span aria-hidden="true">↗</span>
  </button>
  <span class="ashme-cinematic__loading" data-ashme-loading role="status">Preparing the scene</span>
  <span class="ashme-cinematic__progress" data-ashme-progress aria-hidden="true"></span>
</section>
{% capture ashme_scene_asset %}{{ 'ashme-intro-scene.js' | asset_url }}{% endcapture %}
{% capture ashme_materials_asset %}{{ 'ashme-intro-materials.js' | asset_url }}{% endcapture %}
{% assign ashme_scene_path = ashme_scene_asset | split: '?' | first %}
{% assign ashme_materials_path = ashme_materials_asset | split: '?' | first %}
<script type="importmap">
  { "imports": {
    "{{ ashme_scene_path }}": "{{ ashme_scene_asset }}",
    "{{ ashme_materials_path }}": "{{ ashme_materials_asset }}"
  } }
</script>
<script type="module" src="{{ 'ashme-cinematic-intro.js' | asset_url }}"></script>

{% schema %}
{
  "name": "AshMe cinematic intro",
  "tag": "section",
  "class": "section-ashme-cinematic-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ASHME — A QUIETER KIND OF EVERYDAY" },
    { "type": "text", "id": "supporting_text", "label": "Supporting text", "default": "A small moment. A better way to handle ash." },
    { "type": "text", "id": "skip_label", "label": "Skip button", "default": "Skip intro" }
  ],
  "presets": [
    { "name": "AshMe cinematic intro" }
  ]
}
{% endschema %}
