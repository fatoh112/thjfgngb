<section class="ashme-contact-intro" aria-labelledby="AshmeContactIntro-{{ section.id }}">
  <div class="ashme-shell ashme-contact-intro__layout">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="ashme-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 id="AshmeContactIntro-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    </div>
    <div class="ashme-contact-intro__copy">
      {%- if section.settings.body != blank -%}<div class="rte">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.faq_label != blank -%}<a class="ashme-button ashme-button--text" href="{{ section.settings.faq_link | default: '/#ashme-faq' }}">{{ section.settings.faq_label | escape }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AshMe contact intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Here to help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions about AshMe?" },
    { "type": "richtext", "id": "body", "label": "Supporting text", "default": "<p>Tell us what you need help with using the contact form below.</p>" },
    { "type": "text", "id": "faq_label", "label": "FAQ link label", "default": "Browse common questions" },
    { "type": "url", "id": "faq_link", "label": "FAQ link" }
  ],
  "presets": [{ "name": "AshMe contact intro" }]
}
{% endschema %}
