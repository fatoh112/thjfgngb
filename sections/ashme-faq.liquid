<section id="ashme-faq" class="ashme-section ashme-faq" aria-labelledby="AshmeFaq-{{ section.id }}">
  {%- assign contact_page = pages['contact'] -%}
  {%- assign contact_url = section.settings.contact_link | default: contact_page.url -%}
  <div class="ashme-shell ashme-faq__layout">
    <div class="ashme-section__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="ashme-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="AshmeFaq-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.body != blank -%}<div class="ashme-section__body rte">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.contact_label != blank and contact_url != blank -%}<a class="ashme-button ashme-button--text" href="{{ contact_url }}">{{ section.settings.contact_label | escape }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
    </div>
    <div class="ashme-faq__list">
      {%- for block in section.blocks -%}
        <details class="ashme-faq__item" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question | escape }}</span><span class="ashme-faq__plus" aria-hidden="true"></span></summary>
          <div class="ashme-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AshMe FAQs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A few useful answers." },
    { "type": "richtext", "id": "body", "label": "Supporting text", "default": "<p>Still have a question? Get in touch and we’ll point you in the right direction.</p>" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Contact AshMe" },
    { "type": "url", "id": "contact_link", "label": "Contact link" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How do I prepare AshMe?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add water to the indicated level and follow the preparation instructions supplied with your product.</p>" }
    ] }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "AshMe FAQs", "blocks": [
    { "type": "question", "settings": { "question": "How do I prepare AshMe?", "answer": "<p>Add water to the indicated level and follow the preparation instructions supplied with your product.</p>" } },
    { "type": "question", "settings": { "question": "How long should I let it activate?", "answer": "<p>Follow the activation time stated in the instructions supplied with your product.</p>" } },
    { "type": "question", "settings": { "question": "Is AshMe disposable?", "answer": "<p>Yes. AshMe is a disposable ashtray. Follow the product’s disposal guidance and local requirements.</p>" } },
    { "type": "question", "settings": { "question": "Where can I find delivery and returns information?", "answer": "<p>See the delivery and returns information linked in the footer, or contact us if you need help.</p>" } }
  ] }]
}
{% endschema %}
